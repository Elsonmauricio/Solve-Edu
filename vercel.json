{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "Backend/src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { 
      "src": "/(.*)", 
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(googlebot|bingbot|twitterbot|linkedinbot|whatsapp|facebookexternalhit).*" }],
      "dest": "/api/prerender?url=https://solve-edu.vercel.app/$1" 
    },
    { "src": "/api/(.*)", "dest": "Backend/src/app.js" },
    { "src": "/assets/(.*)", "dest": "/Frontend/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/Frontend/index.html" }
  ]
}